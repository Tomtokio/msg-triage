# VetTriage v0 — variabili d'ambiente.
# Copia questo file in .env e compila i valori. NON committare .env (è in .gitignore).

# Callbell — API key (richiede il piano "Chat Management Plus").
CALLBELL_API_KEY=

# Anthropic — API key per il triage.
ANTHROPIC_API_KEY=

# Telegram — token del bot (da @BotFather).
TELEGRAM_BOT_TOKEN=

# Telegram — ID numerico dell'unico utente autorizzato (whitelist).
TELEGRAM_ALLOWED_USER_ID=

# Supabase — persistenza dei run (storico + memoria). Entrambe RICHIESTE al boot,
# ma la persistenza si attiva solo quando SUPABASE_URL è un vero https://...: finché
# vale "unused" il triage funziona identico e non salva niente.
# SUPABASE_KEY = service_role in formato JWT LEGACY (eyJh...), non sb_secret_...:
# col formato nuovo lo schema custom dà errori di permessi. Vedi docs/runbook.md § E.
SUPABASE_URL=unused
SUPABASE_KEY=unused

# Livello di logging (opzionale): DEBUG | INFO | WARNING | ERROR. Default: INFO.
LOG_LEVEL=INFO

# T10 — estrazione dei fatti di stato (opzionale): true | false (default false).
# Fuori dalle variabili richieste al boot apposta, come le TELEMETRY_*: una feature
# non deve poter impedire un avvio. A true il triage aggiunge alla sua UNICA chiamata
# LLM un blocco che estrae fatti dai messaggi (ricovero, dimissione, animali,
# proprietario); a false la richiesta al modello è identica byte per byte a prima.
# Da sola non produce ancora nessuna proposta e non scrive NIENTE su Callbell: serve
# solo il materiale grezzo per le regole deterministiche che arrivano dopo.
ENABLE_PROPOSALS=false

# Telemetria (vet_agents_telemetry) — TUTTE E TRE OPZIONALI: se mancano, la libreria
# logga un warning e diventa un no-op, il bot funziona identico. Non sono nella lista
# delle variabili richieste al boot apposta: la telemetria non deve poter impedire un
# avvio. La libreria si installa a parte (vedi docs/runbook.md § F), non è in pyproject.
# URL/KEY: stesso progetto Supabase di SUPABASE_URL/KEY ma schema diverso (telemetry).
# La libreria legge SOLO queste: non riusa SUPABASE_URL/SUPABASE_KEY.
TELEMETRY_SUPABASE_URL=
TELEMETRY_SUPABASE_KEY=
# true (default) | false — false spegne tutto in silenzio, utile in dev.
TELEMETRY_ENABLED=true
