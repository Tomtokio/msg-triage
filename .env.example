# VetTriage v0 — variabili d'ambiente.
# Copia questo file in .env e compila i valori. NON committare .env (è in .gitignore).

# Callbell — API key (richiede il piano "Chat Management Plus").
CALLBELL_API_KEY=

# Anthropic — API key per il triage.
ANTHROPIC_API_KEY=

# Telegram — token del bot (da @BotFather).
TELEGRAM_BOT_TOKEN=

# Telegram — ID numerico dell'unico utente autorizzato (whitelist).
TELEGRAM_ALLOWED_USER_ID=

# Supabase — persistenza dei run (storico + memoria). Entrambe RICHIESTE al boot,
# ma la persistenza si attiva solo quando SUPABASE_URL è un vero https://...: finché
# vale "unused" il triage funziona identico e non salva niente.
# SUPABASE_KEY = service_role in formato JWT LEGACY (eyJh...), non sb_secret_...:
# col formato nuovo lo schema custom dà errori di permessi. Vedi docs/runbook.md § E.
SUPABASE_URL=unused
SUPABASE_KEY=unused

# Livello di logging (opzionale): DEBUG | INFO | WARNING | ERROR. Default: INFO.
LOG_LEVEL=INFO
